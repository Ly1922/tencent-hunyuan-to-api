# 服务监听配置
HOST=0.0.0.0
PORT=7860

# 腾讯 AI Studio Cookie（从浏览器开发者工具请求标头中复制）
TENCENT_COOKIE="hunyuan_user=...; hunyuan_token=...; hunyuan_source=web;"

# 腾讯 AI Studio 对应会话 ID（从浏览器地址栏或接口路径复制）
DEFAULT_CHAT_ID=dap8gfk2c3m4o8kl0ld0

# 接口保护密钥（留空则不开启验证，设置后客户端请求需带 Bearer sk-xxx）
API_KEYS=sk-tencent-hunyuan-123456

# 生图超时时间（秒）
REQUEST_TIMEOUT=120.0
